<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sellora.Domain\Sellora.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 02 review: StockAvailability.UseReservedSource is a test-only seam. -->
    <InternalsVisibleTo Include="Sellora.Tests" />
    <InternalsVisibleTo Include="Sellora.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen migration SQL (seed + backfill); logical name = file name, read by MigrationSql.Read. Never edit after release (SHA-256 pinned by a test). -->
    <EmbeddedResource Include="Data/Migrations/Sql/*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
